{
  "name": "assignment-template",
  "version": "1.0.0",
  "description": "This is an ongoing repository for BVD 103.",
  "main": "src/server.ts",
  "scripts": {
"start-server": "tsx ./src/index.ts",
"test": "vitest",
"test:unit": "vitest run src/",
"test:api": "vitest run tests/",
"test:ci": "vitest run src/",
    "lint": "eslint . --cache",
    "fix-lint": "eslint . --fix --cache",
    "fmt": "prettier --write .",
    "fmt-check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "tsoa:spec": "tsoa spec",
    "tsoa:routes": "tsoa routes",
    "tsoa:build": "npm run tsoa:spec && npm run tsoa:routes"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "client-sdk": "file:./client-sdk",
    "koa": "^2.15.2",
    "koa-bodyparser": "^4.4.1",
    "koa-qs": "^3.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "mongodb": "^7.0.0",
    "tsoa": "^7.0.0-alpha.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/koa": "~2.15.0",
    "@types/koa__cors": "~5.0.0",
    "@types/koa__router": "^12.0.5",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-qs": "~2.0.3",
    "@types/node": "^25.0.3",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^10.4.3",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.1",
    "vitest": "^4.1.12"
  }
}
